<!--
  Rule 110008 - Credential Dumping (Mimikatz / LSASS memory access)
  MITRE ATT&CK: T1003 - OS Credential Dumping (LSASS Memory)

  Source: Sysmon Event ID 10 (ProcessAccess) - access to lsass.exe

  Detects credential dumping when a process (e.g. via the Meterpreter
  kiwi extension running "sekurlsa::logonpasswords") opens a handle to
  lsass.exe with an access mask consistent with credential extraction.

  Response: Wazuh Active-Response
    - win-logoff.ps1 (local)      -> disconnects the compromised session
    - disable-account.ps1 (agent) -> disables the compromised AD account
      on the Domain Controller, to prevent reuse of stolen credentials
-->
<group name="windows,active_directory,attack,credential_access,">

  <rule id="110008" level="12">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.TargetImage" type="pcre2">(?i)\\system32\\lsass.exe</field>
    <field name="win.eventdata.GrantedAccess" type="pcre2">(?i)0x1010|0x1f3fff|0x147a</field>
    <description>Possible credential dumping using mimikatz</description>
    <mitre>
      <id>T1003</id>
    </mitre>
  </rule>

</group>
